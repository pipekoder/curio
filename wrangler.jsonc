{
  "name": "curio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAGAZINE_AI_ENABLED": "true",
    "LEGACY_MAGAZINE_AI_ENABLED": "true",
    "EDITORIAL_REVIEW_ENABLED": "true",
    "EDITORIAL_PUBLIC_AI_ENABLED": "true",
    "EDITORIAL_KNOWLEDGE_V2_ENABLED": "true",
    "EDITORIAL_HYBRID_ENABLED": "true",
    "EDITORIAL_ARTICLES_ENABLED": "true",
    "EDITORIAL_ARTICLE_PREPARATION_ENABLED": "true",
    "EDITORIAL_WONDER_PROVIDER_VERIFIED": "true",
    "META_WONDER_MODEL": "muse-wonder-1.0",
    "CULTURAL_INTELLIGENCE_V3_ENABLED": "true",
    "CULTURAL_RESEARCH_PLANNER_ENABLED": "true",
    "CULTURAL_RELATIONSHIP_AI_ENABLED": "true",
    "CULTURAL_LONGFORM_ENABLED": "true",
    "ARTICLE_PREP_MAX_PER_HOUR": "24",
    "ARTICLE_PREP_MAX_PER_DAY": "48",
    "ARTICLE_PREP_WINDOW_LIMIT": "4",
    "ARTICLE_PREP_WINDOW_SECONDS": "16",
    "ARTICLE_PREP_CONCURRENCY": "4",
    "DEMO_TESTING_MODE": "true",
    "DEMO_TESTING_WINDOW_SECONDS": "900",
    "DEMO_TESTING_WINDOW_UNITS": "200",
    "EDITORIAL_DEMO_BUDGET_ENABLED": "true",
    "EDITORIAL_DEMO_DAILY_UNITS": "1000",
    "EDITORIAL_DEMO_LIFETIME_UNITS": "5000",
    "INFERENCE_STANDARD_HOURLY_UNITS": "200",
    "INFERENCE_REVIEWED_HOURLY_UNITS": "200",
    "INFERENCE_TESTER_HOURLY_UNITS": "200",
    "INFERENCE_TESTER_DAILY_UNITS": "1000",
    "INFERENCE_COOLDOWN_SECONDS": "5",
    "ARTICLE_CHIEF_TIMEOUT_MS": "60000",
    "EDITORIAL_PILOT_VERSION_IDS": "version-ad879e8cca0061e557b37a1642819a8b65ebd614d00aa61648c2cd01bcbfe1c3,version-c74a0a38e916733401770c92c25e617a4c0390f921f32f592a9da7edc1344ca2,version-45f4058505f3c5561cde15beec7fa4d3be2f539f29cbd26046cf0d2bce2f64ef,version-60a6a1bb1bb8392a5fd61b275ef9182cea3145fe90310df2e44596b682e6668e,version-5a1fcb226535d6f96bb927c0faa8dc83ca8cf2b8bfa6c5bb7a866d12b10dcc60,version-1ae7f94608a4452142153bfa3a8019dfda94a91630f3ec2c5acc247a6b34fb48",
    "ASSET_AI_ENABLED": "true",
    "SAM_DECODER_ENABLED": "true",
    "META_SPARK_MODEL": "muse-spark-1.3",
    "MAGAZINE_MAX_CALLS": "100",
    "INFERENCE_DAILY_MAX_UNITS": "100",
    "CATALOG_OPERATOR_ENABLED": "true",
    "CATALOG_PUBLIC_ENABLED": "true",
    "PUBLIC_APP_ORIGIN": "https://curio.shuang-han807.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "curio-catalog",
      "database_id": "b39c4f63-74ee-47f6-bb1d-7388ecc88bc7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "curio-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INFERENCE_BUDGET",
        "class_name": "InferenceBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-inference-budget",
      "new_sqlite_classes": [
        "InferenceBudget"
      ]
    }
  ]
}
