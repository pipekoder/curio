{
  "name": "curio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAGAZINE_AI_ENABLED": "false",
    "META_SPARK_MODEL": "muse-spark-1.3",
    "MAGAZINE_MAX_CALLS": "20",
    "CATALOG_OPERATOR_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "curio-catalog",
      "database_id": "b39c4f63-74ee-47f6-bb1d-7388ecc88bc7",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INFERENCE_BUDGET",
        "class_name": "InferenceBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-inference-budget",
      "new_sqlite_classes": [
        "InferenceBudget"
      ]
    }
  ]
}
