{
  "name": "curio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "worker:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test:integration": "node scripts/smoke.mjs",
    "test:browser": "playwright test",
    "lint": "eslint shared/editorial*.ts worker/editorial.ts src/EditorialExperience.tsx src/App.tsx tests/editorial*.ts scripts/editorial-live-check.mjs scripts/editorial-validation-smoke.mjs scripts/production-review.mjs",
    "review:production": "node scripts/production-review.mjs",
    "validate:editorial": "node scripts/editorial-live-check.mjs"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "hono": "^4.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
    "miniflare": "^5.20261023.0-beta",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
